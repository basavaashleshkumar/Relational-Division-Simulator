/td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">Evan Wright</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CSE203</td></tr><tr style="background-color:#f8fafc;"><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CS105</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">Evan Wright</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CSE204</td></tr><tr style="background-color:#ffffff;"><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CS106</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">Fiona Gallagher</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CSE202</td></tr><tr style="background-color:#f8fafc;"><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CS106</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">Fiona Gallagher</td><td style="padding:5pt 8pt; border:0.5pt solid #cbd5e1; color:#1e293b;">CSE204</td></tr></table>

